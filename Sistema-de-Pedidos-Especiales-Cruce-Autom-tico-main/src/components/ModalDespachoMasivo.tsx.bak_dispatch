import React, { useState, useMemo } from 'react';
import { 
  X, 
  Truck, 
  Calendar, 
  Clock, 
  CheckCircle2, 
  AlertCircle, 
  Building2, 
  User, 
  Package, 
  ShieldCheck, 
  FileText, 
  Mail,
  Zap,
  TrendingUp,
  RotateCcw
} from 'lucide-react';
import { appsScriptClient } from '../services/appsScriptClient';
import { FilaMatrizCentral } from '../types/cedis';
import { EQUIPO_BODEGA_CEDIS } from '../data/bodeguerosData';
import { CORREO_REMITENTE_OFICIAL } from '../utils/notificacionesPedido';

interface ModalDespachoMasivoProps {
  isOpen: boolean;
  onClose: () => void;
  pedidoIds: string[];
  lineasSeleccionadasKeys?: string[];
  filasMatriz?: FilaMatrizCentral[];
  onDespachoExitoso: (totalDespachados: number, fechaDespacho: string) => void;
  onAbrirNotificacionLote?: (pedidoIds: string[], estatus: string) => void;
}

export const ModalDespachoMasivo: React.FC<ModalDespachoMasivoProps> = ({
  isOpen,
  onClose,
  pedidoIds,
  lineasSeleccionadasKeys = [],
  filasMatriz = [],
  onDespachoExitoso,
  onAbrirNotificacionLote
}) => {
  // Fecha exacta de despacho por defecto: ahora (en hora local para input datetime-local)
  const getFechaActualISO = () => {
    const ahora = new Date();
    ahora.setMinutes(ahora.getMinutes() - ahora.getTimezoneOffset());
    return ahora.toISOString().slice(0, 16);
  };

  const [fechaDespacho, setFechaDespacho] = useState<string>(getFechaActualISO);
  const [bodeguero, setBodeguero] = useState<string>('CE005 - Joel (Admin)');
  const [guiaTransporte, setGuiaTransporte] = useState<string>('');
  const [observaciones, setObservaciones] = useState<string>('');
  const [notificarSucursales, setNotificarSucursales] = useState<boolean>(true);
  const [procesando, setProcesando] = useState<boolean>(false);
  const [error, setError] = useState<string | null>(null);

  // Filtrar filas correspondientes a los pedidos seleccionados
  const lineasSeleccionadas = useMemo(() => {
    if (lineasSeleccionadasKeys && lineasSeleccionadasKeys.length > 0) {
      const setKeys = new Set(lineasSeleccionadasKeys);
      return filasMatriz.filter(f => setKeys.has(`${f.pedidoId}___${f.lineaId || f.codigoRepuesto}`));
    }
    const setIds = new Set(pedidoIds);
    return filasMatriz.filter(f => setIds.has(f.pedidoId));
  }, [filasMatriz, pedidoIds]);

  // Resumen de cantidades y sucursales
  const resumen = useMemo(() => {
    const sucursales = new Set<string>();
    let totalPiezasAsignadas = 0;
    let totalPiezasSolicitadas = 0;

    lineasSeleccionadas.forEach(l => {
      if (l.sucursal) sucursales.add(l.sucursal);
      totalPiezasAsignadas += Number(l.cantidadAsignada) || 0;
      totalPiezasSolicitadas += Number(l.cantidadSolicitada) || 1;
    });

    return {
      totalLineas: lineasSeleccionadas.length,
      totalPiezasAsignadas,
      totalPiezasSolicitadas,
      sucursales: Array.from(sucursales)
    };
  }, [lineasSeleccionadas]);

  if (!isOpen) return null;

  const handleSetHoy = () => {
    setFechaDespacho(getFechaActualISO());
  };

  const handleSetAyer = () => {
    const d = new Date();
    d.setDate(d.getDate() - 1);
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    setFechaDespacho(d.toISOString().slice(0, 16));
  };

  const handleConfirmarDespacho = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!fechaDespacho) {
      setError('Debe especificar la fecha y hora exacta del despacho físico para los KPIs.');
      return;
    }

    setProcesando(true);
    setError(null);

    // Formatear fecha para almacenamiento: YYYY-MM-DD HH:mm:ss
    const fechaFormateada = fechaDespacho.replace('T', ' ') + ':00';

    try {
      const res = await appsScriptClient.despacharPedidosMasivo(
        pedidoIds,
        fechaFormateada,
        bodeguero,
        guiaTransporte,
        observaciones
      );

      setProcesando(false);

      if (res.success) {
        onDespachoExitoso(res.totalDespachados || pedidoIds.length, fechaFormateada);
        onClose();

        if (notificarSucursales && onAbrirNotificacionLote) {
          onAbrirNotificacionLote(pedidoIds, 'Despachado');
        }
      } else {
        setError(res.error || 'Error al procesar el despacho masivo.');
      }
    } catch (err: any) {
      setProcesando(false);
      setError(err.message || 'Error inesperado durante el despacho.');
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md p-4 animate-in fade-in duration-200">
      <div className="bg-[#0b1320] border border-purple-500/50 rounded-2xl max-w-xl w-full shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        {/* Encabezado */}
        <div className="bg-gradient-to-r from-[#120f26] via-[#1a1338] to-[#0c1727] border-b border-purple-900/40 p-4 sm:p-5 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-purple-950/80 border border-purple-500/40 flex items-center justify-center text-purple-400 shadow-lg shadow-purple-950/50">
              <Truck className="w-5 h-5" />
            </div>
            <div>
              <h2 className="text-base font-bold text-white tracking-tight flex items-center gap-2">
                Despacho Físico Masivo a Sucursal
                <span className="px-2 py-0.5 text-[10px] rounded-full bg-purple-900/60 border border-purple-500/40 text-purple-200 font-mono">
                  CEDIS Changan
                </span>
              </h2>
              <div className="text-xs text-purple-300/80 font-mono">
                {pedidoIds.length} {pedidoIds.length === 1 ? 'pedido seleccionado' : 'pedidos seleccionados'} para despacho
              </div>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800/60 transition cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Contenido scrolleable */}
        <form onSubmit={handleConfirmarDespacho} className="p-4 sm:p-6 overflow-y-auto space-y-4 text-xs">
          {error && (
            <div className="p-3 bg-rose-950/40 border border-rose-500/50 rounded-xl flex items-start gap-2.5 animate-in fade-in duration-200">
              <AlertCircle className="w-4 h-4 text-rose-400 shrink-0 mt-0.5" />
              <div className="text-xs text-rose-200 font-sans">{error}</div>
            </div>
          )}

          {/* Tarjeta de impacto en KPIs */}
          <div className="bg-gradient-to-r from-purple-950/30 to-indigo-950/30 border border-purple-500/30 rounded-xl p-3.5 flex items-start gap-3">
            <div className="w-7 h-7 rounded-lg bg-purple-900/50 border border-purple-500/40 flex items-center justify-center text-purple-300 shrink-0 mt-0.5">
              <TrendingUp className="w-4 h-4" />
            </div>
            <div className="space-y-1">
              <span className="font-semibold text-purple-200 block">
                Impacto Directo en KPIs Ejecutivos & Lead Time (OTIF)
              </span>
              <p className="text-[11px] text-purple-300/70 leading-relaxed">
                La <strong className="text-purple-100">fecha exacta del despacho</strong> ingresada alimentará el cálculo de <strong className="text-white">Tiempo de Ciclo de Pedido</strong>, la tasa <strong className="text-white">OTIF (On-Time In-Full)</strong> y el informe ejecutivo gerencial de CEDIS.
              </p>
            </div>
          </div>

          {/* Resumen del Lote */}
          <div className="grid grid-cols-3 gap-2 p-3 bg-slate-900/60 border border-slate-800 rounded-xl">
            <div className="text-center p-2 rounded-lg bg-slate-950/50 border border-slate-800">
              <span className="text-slate-400 text-[10px] block">Pedidos</span>
              <span className="text-base font-bold text-white font-mono">{pedidoIds.length}</span>
            </div>
            <div className="text-center p-2 rounded-lg bg-slate-950/50 border border-slate-800">
              <span className="text-slate-400 text-[10px] block">Ítems / Repuestos</span>
              <span className="text-base font-bold text-purple-400 font-mono">
                {resumen.totalLineas || pedidoIds.length}
              </span>
            </div>
            <div className="text-center p-2 rounded-lg bg-slate-950/50 border border-slate-800">
              <span className="text-slate-400 text-[10px] block">Sucursales</span>
              <span className="text-xs font-bold text-emerald-400 truncate block mt-1" title={resumen.sucursales.join(', ')}>
                {resumen.sucursales.length > 0 ? resumen.sucursales.slice(0, 2).join(', ') + (resumen.sucursales.length > 2 ? ' (+'+(resumen.sucursales.length - 2)+')' : '') : 'Múltiples'}
              </span>
            </div>
          </div>

          {/* Campo Crítico: Fecha y Hora Exacta de Despacho */}
          <div className="space-y-2 bg-[#0d1624] border border-purple-500/40 rounded-xl p-3.5">
            <div className="flex items-center justify-between">
              <label className="text-xs font-bold text-purple-200 flex items-center gap-1.5">
                <Calendar className="w-4 h-4 text-purple-400" />
                Fecha y Hora Exacta del Despacho Físico:
                <span className="text-rose-400">*</span>
              </label>
              <div className="flex items-center gap-1">
                <button
                  type="button"
                  onClick={handleSetHoy}
                  className="px-2 py-0.5 rounded bg-purple-900/50 hover:bg-purple-800/60 text-purple-300 text-[10px] font-semibold border border-purple-500/30 transition cursor-pointer"
                >
                  Ahora / Hoy
                </button>
                <button
                  type="button"
                  onClick={handleSetAyer}
                  className="px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[10px] font-semibold border border-slate-700 transition cursor-pointer"
                >
                  Ayer
                </button>
              </div>
            </div>

            <input
              type="datetime-local"
              value={fechaDespacho}
              onChange={(e) => setFechaDespacho(e.target.value)}
              required
              className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-purple-500/50 text-white font-mono text-xs focus:ring-2 focus:ring-purple-500 focus:outline-none shadow-inner"
            />
            <span className="text-[10px] text-slate-400 block">
              Formato estándar local: Día / Mes / Año con Hora y Minuto de salida de bodega.
            </span>
          </div>

          {/* Responsable de Bodega / Despachador */}
          <div className="space-y-1.5">
            <label className="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
              <User className="w-3.5 h-3.5 text-slate-400" />
              Responsable de Entrega / Bodeguero CEDIS:
            </label>
            <select
              value={bodeguero}
              onChange={(e) => setBodeguero(e.target.value)}
              className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-slate-200 text-xs focus:ring-1 focus:ring-purple-500 focus:outline-none"
            >
              {EQUIPO_BODEGA_CEDIS.map(b => (
                <option key={b.codigo} value={b.codigo + ' - ' + b.nombre}>
                  {b.codigo} - {b.nombre} ({b.cargo})
                </option>
              ))}
              <option value="Conductor Ruta CEDIS">Conductor / Ruta Externa CEDIS</option>
              <option value="Personal Sucursal Retiro">Retiro en Mostrador Central por Sucursal</option>
            </select>
          </div>

          {/* Guía de Envío / Transporte (Opcional) */}
          <div className="space-y-1.5">
            <label className="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
              <Truck className="w-3.5 h-3.5 text-slate-400" />
              Guía de Transporte / Placa de Vehículo / Conductor (Opcional):
            </label>
            <input
              type="text"
              placeholder="Ej: GUIA-2026-0913 / Camión CEDIS #2"
              value={guiaTransporte}
              onChange={(e) => setGuiaTransporte(e.target.value)}
              className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-slate-200 text-xs focus:ring-1 focus:ring-purple-500 focus:outline-none"
            />
          </div>

          {/* Observaciones (Opcional) */}
          <div className="space-y-1.5">
            <label className="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
              <FileText className="w-3.5 h-3.5 text-slate-400" />
              Observaciones de Despacho (Opcional):
            </label>
            <textarea
              rows={2}
              placeholder="Notas sobre el embalaje, marchamos o instrucciones de entrega..."
              value={observaciones}
              onChange={(e) => setObservaciones(e.target.value)}
              className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-700 text-slate-200 text-xs focus:ring-1 focus:ring-purple-500 focus:outline-none resize-none"
            />
          </div>

          {/* Checkbox Notificar */}
          <div className="pt-2 border-t border-slate-800">
            <label className="flex items-start gap-2.5 cursor-pointer select-none">
              <input 
                type="checkbox" 
                checked={notificarSucursales}
                onChange={(e) => setNotificarSucursales(e.target.checked)}
                className="mt-0.5 w-4 h-4 rounded bg-slate-950 border-slate-700 text-purple-600 focus:ring-0 focus:ring-offset-0 cursor-pointer"
              />
              <div className="text-[11px] text-slate-300">
                <span className="font-semibold text-white block">
                  Generar notificación automática de despacho a sucursales
                </span>
                <span className="text-slate-400">
                  Prepara el comprobante de entrega y aviso desde <strong className="text-purple-300">{CORREO_REMITENTE_OFICIAL}</strong>.
                </span>
              </div>
            </label>
          </div>

          {/* Botones de acción */}
          <div className="pt-3 border-t border-slate-800 flex items-center justify-end gap-2.5">
            <button
              type="button"
              onClick={onClose}
              disabled={procesando}
              className="px-4 py-2 rounded-xl text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 font-semibold transition cursor-pointer"
            >
              Cancelar
            </button>
            <button
              type="submit"
              disabled={procesando}
              className="flex items-center gap-2 px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold shadow-lg shadow-purple-900/40 transition cursor-pointer disabled:opacity-50"
            >
              {procesando ? (
                <>
                  <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                  <span>Despachando {pedidoIds.length} pedidos...</span>
                </>
              ) : (
                <>
                  <Truck className="w-4 h-4" />
                  <span>Confirmar y Despachar {pedidoIds.length} Pedidos</span>
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
};
